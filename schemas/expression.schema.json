{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Expression",
  "type": "object",
  "required": [
    "expression_id",
    "concept_id",
    "sense_id",
    "language",
    "lemma",
    "display_form",
    "part_of_speech",
    "provenance_type",
    "license",
    "status"
  ],
  "properties": {
    "expression_id": {
      "type": "string",
      "pattern": "^expr-(en|ja|vi)-[a-zA-Z0-9_-]+$"
    },
    "concept_id": {
      "type": "string",
      "pattern": "^concept-[a-zA-Z0-9_-]+$"
    },
    "sense_id": {
      "type": "string",
      "pattern": "^sense-[a-zA-Z0-9_-]+$"
    },
    "language": {
      "type": "string",
      "enum": ["en", "ja", "vi"]
    },
    "lemma": {
      "type": "string",
      "minLength": 1
    },
    "display_form": {
      "type": "string",
      "minLength": 1
    },
    "reading": {
      "type": ["string", "null"]
    },
    "pronunciation": {
      "type": ["string", "null"]
    },
    "romanization": {
      "type": ["string", "null"]
    },
    "part_of_speech": {
      "type": "string"
    },
    "register": {
      "type": "string"
    },
    "usage_notes": {
      "type": ["string", "null"]
    },
    "language_metadata": {
      "type": "object"
    },
    "provenance_type": {
      "type": "string",
      "enum": [
        "OFFICIAL_EXTRACTED",
        "OFFICIAL_CURATED",
        "INTERNAL_CURATED",
        "MODEL_ASSISTED",
        "SOURCE_DERIVED",
        "COMMUNITY_CONSENSUS"
      ]
    },
    "source_evidence": {
      "type": "array",
      "items": { "type": "object" }
    },
    "license": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["verified", "candidate", "quarantine"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
