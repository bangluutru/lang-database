{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Example",
  "type": "object",
  "required": [
    "example_id",
    "sense_id",
    "concept_id",
    "language",
    "text",
    "source_id",
    "license",
    "attribution",
    "review_status"
  ],
  "properties": {
    "example_id": {
      "type": "string",
      "pattern": "^ex-[a-zA-Z0-9_-]+$"
    },
    "sense_id": {
      "type": "string",
      "pattern": "^sense-[a-zA-Z0-9_-]+$"
    },
    "concept_id": {
      "type": "string",
      "pattern": "^concept-[a-zA-Z0-9_-]+$"
    },
    "language": {
      "type": "string",
      "enum": ["en", "ja", "vi"]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "translation_links": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "source_id": {
      "type": "string"
    },
    "source_record_id": {
      "type": ["string", "null"]
    },
    "license": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": ["verified", "pending", "quarantined"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
