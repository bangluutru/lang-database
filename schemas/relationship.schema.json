{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Relationship",
  "type": "object",
  "required": [
    "relationship_id",
    "source_type",
    "source_id",
    "target_type",
    "target_id",
    "relationship_type",
    "bidirectional"
  ],
  "properties": {
    "relationship_id": {
      "type": "string",
      "pattern": "^rel-[a-zA-Z0-9_-]+$"
    },
    "source_type": {
      "type": "string",
      "enum": ["concept", "sense", "expression"]
    },
    "source_id": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": ["concept", "sense", "expression"]
    },
    "target_id": {
      "type": "string"
    },
    "relationship_type": {
      "type": "string"
    },
    "bidirectional": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
